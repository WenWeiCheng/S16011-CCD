# -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.autosave
*.orig
*.rej
*.tmp

# Obsidian 个人视图
.obsidian/workspace.json
.obsidian/appearance.json
.obsidian/cache/
.trash/

# IDE（CMake 工程的 compile_commands.json 来自 build/，已自动忽略）
.vscode/
.idea/
_ide/

